# 述树 · 后端环境变量样例
# 用法：复制为 server/.env 后按注释填写真实值。.env 已被 .gitignore 忽略，请勿提交。
# 本文件只包含占位符，不包含任何真实密钥。

# ── 服务端口 ────────────────────────────────────────────────
PORT=

# ── PostgreSQL 连接串 ───────────────────────────────────────
# 例：postgres://user:password@127.0.0.1:5432/shutree
DATABASE_URL=

# ── PaddleOCR 异步 API 访问令牌 ─────────────────────────────
# 从 PaddleOCR 平台获取；请求头 Authorization: Bearer <TOKEN>
PADDLEOCR_ACCESS_TOKEN=

# ── 管理员接口密钥 ──────────────────────────────────────────
# 管理端接口要求请求头 Authorization: Bearer <ADMIN_API_KEY>
ADMIN_API_KEY=

# ── 允许跨域访问的来源 ──────────────────────────────────────
# 精确匹配，多个用英文逗号分隔；留空表示禁用跨域
# 例：http://localhost:5173,https://shushu.app
CORS_ORIGIN=

# ── 是否开放公开的 /api/ocr/material 接口 ───────────────────
# true / 1 / yes 表示开放；其余值（含留空）表示关闭
OCR_PUBLIC_ENABLED=

# ── 翻译服务（LibreTranslate 兼容）──────────────────────────
# 留空时 /api/translate 返回 503
# 例：https://libretranslate.example.com/translate
TRANSLATE_API_URL=

# 部分实例需要 api_key；留空则不发送该字段
TRANSLATE_API_KEY=

# ── OCR 原始图片落盘目录 ────────────────────────────────────
# 相对路径以 server/ 为基准；数据库只保存相对路径
# 例：data/ocr
OCR_STORAGE_DIR=

# ── 音视频转字幕 ASR（Phase 1.5：本地自建 faster-whisper sidecar）─────
# provider != local 或缺 ASR_PYTHON_PATH = 转录接口未接入：
# POST /api/asr/jobs 返回 503，前端显示「转录服务未接入」，绝不返回假字幕。
#
# ASR_PROVIDER           local = 启用本地转录（自动 spawn sidecar 子进程）
# ASR_PYTHON_PATH        venv 的 python.exe（安装步骤见 asr_service/README.md）：
#                          cd server/asr_service && python -m venv venv
#                          ./venv/Scripts/pip install -r requirements-asr.txt
# ASR_MODEL_DIR          Whisper 模型目录，默认 data/asr-models/whisper-small
#                         （模型下载命令见 asr_service/README.md，约 461MB）
# ASR_SIDECAR_PORT       sidecar 端口，默认 8177（仅监听 127.0.0.1）
# ASR_SIDECAR_TIMEOUT_MS Node → sidecar 单次 HTTP 超时，默认 10000（毫秒）
# ASR_SIDECAR_LOAD_TIMEOUT_MS  sidecar 启动 + 模型加载的 health 门控宽限，默认 60000（毫秒）
# ASR_DATA_DIR           媒体中转目录，默认 data/asr（in/ 由 Node 写、终态清理；
#                        out/ 为 sidecar 的 canonical transcript 落盘）
# ASR_DEBUG_SAVE_RAW     debug：保存 sidecar 原始响应到 data/asr-debug/（默认关，
#                        仅排障用；Transcript 只认 canonical 字段）
ASR_PROVIDER=local
ASR_PYTHON_PATH=asr_service/venv/Scripts/python.exe
ASR_MODEL_DIR=
ASR_SIDECAR_PORT=
ASR_SIDECAR_TIMEOUT_MS=
ASR_SIDECAR_LOAD_TIMEOUT_MS=
ASR_DATA_DIR=
ASR_DEBUG_SAVE_RAW=
