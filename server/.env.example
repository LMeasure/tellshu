# 述树 · 后端环境变量样例
# 用法：复制为 server/.env 后按注释填写真实值。.env 已被 .gitignore 忽略，请勿提交。
# 本文件只包含占位符，不包含任何真实密钥。

# ── 服务端口 ────────────────────────────────────────────────
PORT=

# ── PostgreSQL 连接串 ───────────────────────────────────────
# 例：postgres://user:password@127.0.0.1:5432/shutree
DATABASE_URL=

# ── PaddleOCR 异步 API 访问令牌 ─────────────────────────────
# 从 PaddleOCR 平台获取；请求头 Authorization: Bearer <TOKEN>
PADDLEOCR_ACCESS_TOKEN=

# ── 管理员接口密钥 ──────────────────────────────────────────
# 管理端接口要求请求头 Authorization: Bearer <ADMIN_API_KEY>
ADMIN_API_KEY=

# ── 允许跨域访问的来源 ──────────────────────────────────────
# 精确匹配，多个用英文逗号分隔；留空表示禁用跨域
# 例：http://localhost:5173,https://shushu.app
CORS_ORIGIN=

# ── 是否开放公开的 /api/ocr/material 接口 ───────────────────
# true / 1 / yes 表示开放；其余值（含留空）表示关闭
OCR_PUBLIC_ENABLED=

# ── 翻译服务（LibreTranslate 兼容）──────────────────────────
# 留空时 /api/translate 返回 503
# 例：https://libretranslate.example.com/translate
TRANSLATE_API_URL=

# 部分实例需要 api_key；留空则不发送该字段
TRANSLATE_API_KEY=

# ── OCR 原始图片落盘目录 ────────────────────────────────────
# 相对路径以 server/ 为基准；数据库只保存相对路径
# 例：data/ocr
OCR_STORAGE_DIR=
