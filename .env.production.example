# 述树 · 生产环境变量样例
# 在 Vercel / Netlify 的项目设置里填同名环境变量（不要提交真实文件到仓库）
#
# 只需一个变量：词库数据基址。末尾必须带 "/"。
#
# 步骤：
#   1. python scripts/upload_data.py            # 上传 410MB 数据到 R2
#   2. 在 Cloudflare R2 开启公开访问（或绑定自定义域名，如 data.shushu.app）
#   3. 把下面的地址填成你的公开前缀
#
# 示例：
#   VITE_DATA_BASE_URL=https://data.shushu.app/linguabase/v1/
#   VITE_DATA_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev/linguabase/v1/
#
# ⚠️ 跨域：R2 桶需要配 CORS，允许你的站点域名 GET。
#    最小 CORS 配置（R2 控制台 → 桶 → Settings → CORS Policy）：
#    [
#      {
#        "AllowedOrigins": ["https://你的站点域名", "http://localhost:5173"],
#        "AllowedMethods": ["GET", "HEAD"],
#        "AllowedHeaders": ["*"],
#        "MaxAgeSeconds": 86400
#      }
#    ]
#
VITE_DATA_BASE_URL=

# 数据版本号，默认 v1，一般**不用填**。
# 只有发新版词库时才动它：先 VITE_DATA_VERSION=v2 跑 upload_data.py 上传 linguabase/v2/，
# 再把这里改成 v2 重新部署。老客户端继续读 v1，可灰度、可秒回滚。
VITE_DATA_VERSION=v1
