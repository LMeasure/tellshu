# 述树 · 环境变量样例（复制为 .env.local 后按需填写；不要把 .env.local 提交到仓库）

# ── 词库数据基址 ──────────────────────────────────────────────
# 数据（410MB，含 353MB 英文释义分片）不在 public/ 下，不参与打包。
#
# 留空  => 同源回退 {BASE_URL}data/linguabase/v1/
#          · npm run dev / preview：由 vite.config.ts 的 localDataPlugin 直出本地 data/ 目录
#          · 自托管：把仓库根 data/ 一并放到站点根，由 Nginx / 静态服务器提供
#
# 填值  => 外部对象存储（生产推荐），末尾必须带 "/"
#          例：VITE_DATA_BASE_URL=https://data.shushu.app/linguabase/v1/
#          ⚠️ 跨域时需在对象存储上开启 CORS（允许 GET，允许 Origin 为你的站点域名）
VITE_DATA_BASE_URL=

# ── 数据版本号 ────────────────────────────────────────────────
# 数据路径形如 <基址>data/linguabase/<版本>/。默认 v1。
# **发新版数据的正确姿势**（路径即版本，可灰度、可秒回滚）：
#   1. 导出新数据到 data/linguabase/v2/
#   2. VITE_DATA_VERSION=v2 跑 scripts/upload_data.py → 传成 linguabase/v2/
#   3. 把这里改成 v2 并重新部署前端
#   4. 老客户端仍在读 v1，互不影响；确认无误后再决定是否清理 v1
#
# ⚠️ 改这个值必须重新构建（Vite 在构建期把它内联进产物）。
#   想「不重新构建就切数据源」，用运行期覆盖 window.__SHUSHU_DATA_BASE__（给完整基址）。
VITE_DATA_VERSION=v1
