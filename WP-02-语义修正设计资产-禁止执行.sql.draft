--   -- 跨表取证据本体（替代 V1.2.30 §5.1 不可执行的跨表 CHECK）
--   SELECT r.evidence_snapshot_id, r.collector_id, r.payload_sha256
--     INTO v_sid, v_collector, v_hash
--     FROM shutree_sec.r2_evidence_record r
