-- ###########################################################################
-- §5 【WP-04 数据归属修正】manifest 与 recovery_runs
-- 官方 PG-07 19.5.5：恢复目标设置『仅适用于恢复期间』『后续恢复必须重置』；
-- PG-03 19.5.6：『只能在服务器启动时设置』且『同一时刻至多一个恢复目标』；
-- pause 下可『改到更晚目标并重启继续恢复』 ⇒ 同一 base backup 允许多个不同 T。
-- 结论：T 是【单次恢复任务参数】，不是备份固有属性 ⇒ 从 manifest 移出。
-- ###########################################################################
-- -- 5.1 修正后的 backup_manifests（只存备份元数据）
-- CREATE TABLE shutree_sec.backup_manifests (
--     manifest_id           uuid PRIMARY KEY DEFAULT gen_random_uuid(),
--     backup_label          text NOT NULL,
--     backup_start_lsn      pg_lsn NOT NULL,          -- S：备份固有
--     backup_stop_lsn       pg_lsn NOT NULL,          -- E：备份固有，T 的下界
--     backup_end_time       timestamptz NOT NULL,     -- B：备份固有
--     backup_label_ref      text NOT NULL,
--     tablespace_map_ref    text,
--     timeline              bigint NOT NULL,
--     wal_continuity        boolean NOT NULL,         -- 截至 E 的 WAL 连续性
--     asset_snapshot        jsonb NOT NULL,
--     r2_object_list        jsonb,
--     fence_gen             bigint,
--     seq                   bigint,
--     hmac                  text NOT NULL,
--     created_at            timestamptz NOT NULL DEFAULT now(),
--     CHECK ((backup_start_lsn <= backup_stop_lsn) IS TRUE),
--     CHECK ((wal_continuity) IS TRUE),
--     CHECK ((backup_label_ref NOT LIKE '%/pg_data/%') IS TRUE)
-- );
-- -- 【移除】recovery_target_lsn 列 与 CHECK(backup_stop_lsn <= recovery_target_lsn)
-- -- 理由：一个 manifest 只能存一个 T，无法记录同一备份的多次恢复；
-- --       且 manifest 随 base backup+WAL 同备同恢复，恢复出的库会携带过期 T。
--
-- -- 5.2 恢复任务台账（1 manifest : N runs）
-- -- 部署位置：恢复目标集群【之外】的控制平面/独立审计库。
-- -- 若置于被恢复集群内，恢复会把它回滚到备份时点，审计链断裂。
-- CREATE TABLE shutree_sec.recovery_runs (
--     run_id                     uuid PRIMARY KEY DEFAULT gen_random_uuid(),
--     manifest_id                uuid NOT NULL,        -- 【逻辑引用】跨库，不建物理 FK
--     manifest_content_sha256    text NOT NULL,        -- 逻辑引用的内容摘要(独立核验锚点)
--     manifest_hmac              text NOT NULL,        -- 由 backup_manifests.hmac 携带的防篡改签名
--     manifest_verified          text NOT NULL
--         CHECK (manifest_verified IN ('pending_external','verified','unverifiable')),
--     manifest_verify_err        text,                 -- 外部审计库不可用时记录原因
--     requested_target_lsn       pg_lsn NOT NULL,      -- T：单次任务参数
--     recovery_target_inclusive  boolean NOT NULL DEFAULT true,
--     recovery_target_timeline   text NOT NULL,
--     recovery_target_action     text NOT NULL
--         CHECK (recovery_target_action IN ('pause','promote','shutdown')),
--     precheck_result            jsonb NOT NULL,       -- S<=E<=T<=WAL_end / 单一 GUC / W 连续
--     actual_stop_lsn            pg_lsn,               -- 恢复后回填；未实测一律 NULL
--     actual_stop_time           timestamptz,
--     actual_timeline            bigint,
--     verification_result        jsonb,                -- asset_snapshot / r2_object_list 比对
--     verified_by                text,
--     status                     text NOT NULL
--         CHECK (status IN ('planned','running','paused','verified','failed','aborted')),
--     failure_reason             text,
--     started_at                 timestamptz NOT NULL,
--     finished_at                timestamptz,
--     created_at                 timestamptz NOT NULL DEFAULT now()
-- );
-- REVOKE UPDATE, DELETE, TRUNCATE ON shutree_sec.recovery_runs FROM PUBLIC;
--
-- -- 5.2.1 跨库逻辑引用的独立核验（替代物理 FK）
-- -- 【架构与跨库访问方式见 §8；本函数不再自行跨库查询，跨库取数由控制平面 Worker 负责】
-- -- 权威记录位置：backup_manifests 在恢复目标集群【之内】；
-- --             recovery_runs 在控制平面/独立审计库【之外】。
-- --             ⇒ 二者跨数据库，PG 物理 FK 无法成立，改用逻辑引用 + 内容摘要 + 签名 + 独立核验。
-- -- 携带 manifest 是【快照】：recovery_runs 落库时复制 manifest 的
-- --             content_sha256 + hmac（见 5.2 三列），而非持有活引用。
-- -- 外部审计库不可用：manifest_verified='pending_external'，记录 manifest_verify_err，
-- --             该 run 不得被 certify；待审计库恢复后由本函数重验。
-- -- 跨库不一致发现：核对 manifest_content_sha256 与从审计库取回的当前 manifest 摘要，
-- --             不一致 ⇒ manifest_verified='unverifiable' 并写入 manifest_verify_err。
-- -- 回滚后审计链证明：recovery_runs 在恢复目标集群之外，集群恢复回滚不影响本表；
-- --             重验只需重跑本函数，独立核验不依赖被恢复集群的状态。
-- CREATE OR REPLACE FUNCTION shutree_sec.sp_verify_recovery_manifest(
--     p_run_id uuid,
--     p_live_content_sha256 text,   -- 由控制平面 Worker 经显式认证通道从 DB-A 取回后传入
--     p_live_hmac text)             -- 本函数【不再】自行跨库查询；跨库访问由 Worker 负责
-- RETURNS text LANGUAGE plpgsql SECURITY DEFINER
-- SET search_path = pg_catalog, pg_temp AS $$
-- DECLARE v_mid uuid; v_sha text; v_hmac text; v_live_sha text; v_live_hmac text;
-- BEGIN
--   SELECT r.manifest_id, r.manifest_content_sha256, r.manifest_hmac
--     INTO v_mid, v_sha, v_hmac
--     FROM shutree_sec.recovery_runs r WHERE r.run_id = p_run_id;
--   IF NOT FOUND THEN RAISE EXCEPTION 'recovery_run_missing'; END IF;
--   -- 跨库访问由【控制平面 Worker】唯一负责：Worker 经显式认证 API 从 DB-A
--   -- 取回当前 manifest 的 content_sha256 与 hmac，再作为参数传入本函数。
--   -- 本函数【不】直接查询 audit_store.*（PG 普通函数无法跨库，且会引入未授权依赖）。
--   v_live_sha  := p_live_content_sha256;
--   v_live_hmac := p_live_hmac;
--   IF (v_live_sha IS NULL OR v_live_hmac IS NULL) THEN
--     -- 外部审计库（DB-A）经 Worker 取数失败：保持 pending，不 fail-open
--     UPDATE shutree_sec.recovery_runs
--        SET manifest_verified = 'pending_external',
--            manifest_verify_err = 'audit_store_unavailable'
--      WHERE run_id = p_run_id;
--     RETURN 'pending_external';
--   END IF;
--   IF (v_live_sha IS DISTINCT FROM v_sha) OR (v_live_hmac IS DISTINCT FROM v_hmac) THEN
--     UPDATE shutree_sec.recovery_runs
--        SET manifest_verified = 'unverifiable',
--            manifest_verify_err = 'manifest_mismatch'
--      WHERE run_id = p_run_id;
--     RETURN 'unverifiable';
--   END IF;
--   UPDATE shutree_sec.recovery_runs
--      SET manifest_verified = 'verified', manifest_verify_err = NULL
--    WHERE run_id = p_run_id;
--   RETURN 'verified';
